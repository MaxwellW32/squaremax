# Copy to .env.local for development. All values validated by lib/env.ts at boot.

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/squaremax
AUTH_DRIZZLE_URL=postgres://user:password@localhost:5432/squaremax

# Auth.js — https://authjs.dev
# Sign-in is email magic links by default (uses the SMTP settings below);
# Google/GitHub buttons appear only when their credentials are set.
AUTH_URL=http://localhost:3000   # dev only; unset in production behind a proxy
AUTH_SECRET=generate-with--npx auth secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# SMTP (contact + intake emails, tenant notifications, sign-in links)
EMAIL=info@squaremaxtech.com
EMAIL_PASS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# PowerTranz (Squaremax Sites billing + Care Plan) — hosted-page card gateway.
# Get credentials from the FAC/PowerTranz merchant portal.
# For local development set POWERTRANZ_SIMULATE=1 (no credentials needed).
POWERTRANZ_ID=
POWERTRANZ_PASSWORD=
POWERTRANZ_HPP_PAGESET=
POWERTRANZ_HPP_PAGENAME=Default
POWERTRANZ_BASE_URL=https://staging.ptranz.com
POWERTRANZ_SIMULATE=1
# Prices are quoted in USD. If the merchant account settles in JMD, set
# POWERTRANZ_CURRENCY=jmd and the rate used to convert at checkout.
POWERTRANZ_CURRENCY=usd
JMD_PER_USD=

# Daily renewal-reminder cron (see DEPLOY.md): a long random string
CRON_SECRET=

# Custom-domain add-on: the VPS IP clients point their A record at
CUSTOM_DOMAIN_A_RECORD=

# Image uploads: Cloudflare R2 (S3-compatible). Leave all five blank to store
# uploads on local disk (userUploadedData/) — fine for dev and early clients.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Marketing-site ad measurement (never loaded on tenant pages). Optional.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Resend (tenant transactional email add-on) — optional
RESEND_API_KEY=

# Canonical origin (absolute URLs in emails, QR codes, uploads)
SITE_URL=http://localhost:3000
