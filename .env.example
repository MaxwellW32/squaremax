# Copy to .env.local for development. All values validated by lib/env.ts at boot.

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/squaremax
AUTH_DRIZZLE_URL=postgres://user:password@localhost:5432/squaremax

# Auth.js — https://authjs.dev
AUTH_URL=http://localhost:3000   # dev only; unset in production behind a proxy
AUTH_SECRET=generate-with--npx auth secret
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# SMTP (contact + intake emails)
EMAIL=info@squaremaxtech.com
EMAIL_PASS=

# PowerTranz (Squaremax Sites billing + Care Plan) — hosted-page card gateway.
# Get credentials from the FAC/PowerTranz merchant portal.
# For local development set POWERTRANZ_SIMULATE=1 (no credentials needed).
POWERTRANZ_ID=
POWERTRANZ_PASSWORD=
POWERTRANZ_HPP_PAGESET=
POWERTRANZ_HPP_PAGENAME=Default
POWERTRANZ_BASE_URL=https://staging.ptranz.com
POWERTRANZ_SIMULATE=1

# Resend (tenant transactional email add-on) — required from Phase 3
RESEND_API_KEY=

# Canonical origin (absolute URLs in emails, QR codes)
SITE_URL=http://localhost:3000
